{
    "workspace": "../ros2_ws",
    "maps_dir": "maps",
    "control": {
        "max_linear_speed": 1.0,
        "max_angular_speed": 1,
        "command_rate_hz": 20,
        "command_timeout_ms": 600
    },
    "mapping": {
        "auto_start": false
    },
    "tasks": {
        "startup": [
            {
                "id": "foxglove",
                "description": "Foxglove 数据桥接",
                "command": "ros2",
                "args": [
                    "run",
                    "foxglove_bridge",
                    "foxglove_bridge"
                ],
                "env": {
                    "ROS_DOMAIN_ID": "88"
                },
                "delay": 0
            },
            {
                "id": "doglink",
                "description": "DogLink 自研协议网关",
                "command": "bash",
                "args": [
                    "scripts/start_doglink.sh",
                    "--ports",
                    "8770",
                    "8771",
                    "8772",
                    "--node-name",
                    "doglink_simulation"
                ],
                "env": {
                    "ROS_DOMAIN_ID": "88",
                    "FASTRTPS_DEFAULT_PROFILES_FILE": null
                },
                "delay": 0
            }
        ],
        "simulation_indoor": [
            {
                "id": "simulation_indoor",
                "description": "Isaac Sim 室内巡检场景",
                "command": "bash",
                "args": [
                    "scripts/start_simulation.sh",
                    "indoor",
                    "--control-port",
                    "8766",
                    "--headless"
                ],
                "delay": 0
            },
            {
                "id": "simulation_indoor_ros",
                "description": "室内场景 ROS 2 双向桥接",
                "command": "/usr/bin/python3",
                "args": [
                    "simulation/ros2_bridge.py",
                    "--ros-args",
                    "-r",
                    "__node:=isaac_bridge_indoor",
                    "-p",
                    "control_url:=http://127.0.0.1:8766",
                    "-p",
                    "topic_namespace:=indoor"
                ],
                "env": {
                    "ROS_DOMAIN_ID": "88",
                    "FASTRTPS_DEFAULT_PROFILES_FILE": null
                },
                "delay": 1000
            },
            {
                "id": "simulation_indoor_fastlio",
                "description": "室内机器狗 FAST-LIO 3D 定位",
                "command": "ros2",
                "args": [
                    "run",
                    "fast_lio",
                    "fastlio_mapping",
                    "--ros-args",
                    "--params-file",
                    "config/fastlio_sim.yaml",
                    "-r",
                    "__node:=fastlio_indoor",
                    "-r",
                    "/points:=/indoor/points",
                    "-r",
                    "/imu:=/indoor/imu",
                    "-r",
                    "/Odometry:=/indoor/Odometry",
                    "-r",
                    "/cloud_registered:=/indoor/cloud_registered",
                    "-r",
                    "/path:=/indoor/path",
                    "-r",
                    "/tf:=/indoor/tf",
                    "-r",
                    "/Laser_map:=/indoor/Laser_map",
                    "-r",
                    "/cloud_effected:=/indoor/cloud_effected",
                    "-r",
                    "/cloud_registered_body:=/indoor/cloud_registered_body"
                ],
                "env": {
                    "ROS_DOMAIN_ID": "88",
                    "FASTRTPS_DEFAULT_PROFILES_FILE": null
                },
                "delay": 22000
            }
        ],
        "simulation_warehouse": [
            {
                "id": "simulation_warehouse",
                "description": "Isaac Sim 仓库障碍场景",
                "command": "bash",
                "args": [
                    "scripts/start_simulation.sh",
                    "warehouse",
                    "--control-port",
                    "8767",
                    "--headless"
                ],
                "delay": 0
            },
            {
                "id": "simulation_warehouse_ros",
                "description": "仓库场景 ROS 2 双向桥接",
                "command": "/usr/bin/python3",
                "args": [
                    "simulation/ros2_bridge.py",
                    "--ros-args",
                    "-r",
                    "__node:=isaac_bridge_warehouse",
                    "-p",
                    "control_url:=http://127.0.0.1:8767",
                    "-p",
                    "topic_namespace:=warehouse"
                ],
                "env": {
                    "ROS_DOMAIN_ID": "88",
                    "FASTRTPS_DEFAULT_PROFILES_FILE": null
                },
                "delay": 1000
            },
            {
                "id": "simulation_warehouse_fastlio",
                "description": "仓库机器狗 FAST-LIO 3D 定位",
                "command": "ros2",
                "args": [
                    "run",
                    "fast_lio",
                    "fastlio_mapping",
                    "--ros-args",
                    "--params-file",
                    "config/fastlio_sim.yaml",
                    "-r",
                    "__node:=fastlio_warehouse",
                    "-r",
                    "/points:=/warehouse/points",
                    "-r",
                    "/imu:=/warehouse/imu",
                    "-r",
                    "/Odometry:=/warehouse/Odometry",
                    "-r",
                    "/cloud_registered:=/warehouse/cloud_registered",
                    "-r",
                    "/path:=/warehouse/path",
                    "-r",
                    "/tf:=/warehouse/tf",
                    "-r",
                    "/Laser_map:=/warehouse/Laser_map",
                    "-r",
                    "/cloud_effected:=/warehouse/cloud_effected",
                    "-r",
                    "/cloud_registered_body:=/warehouse/cloud_registered_body"
                ],
                "env": {
                    "ROS_DOMAIN_ID": "88",
                    "FASTRTPS_DEFAULT_PROFILES_FILE": null
                },
                "delay": 22000
            }
        ],
        "simulation_outdoor": [
            {
                "id": "simulation_outdoor",
                "description": "Isaac Sim 户外坡道场景",
                "command": "bash",
                "args": [
                    "scripts/start_simulation.sh",
                    "outdoor",
                    "--control-port",
                    "8769",
                    "--headless"
                ],
                "delay": 0
            },
            {
                "id": "simulation_outdoor_ros",
                "description": "户外场景 ROS 2 双向桥接",
                "command": "/usr/bin/python3",
                "args": [
                    "simulation/ros2_bridge.py",
                    "--ros-args",
                    "-r",
                    "__node:=isaac_bridge_outdoor",
                    "-p",
                    "control_url:=http://127.0.0.1:8769",
                    "-p",
                    "topic_namespace:=outdoor"
                ],
                "env": {
                    "ROS_DOMAIN_ID": "88",
                    "FASTRTPS_DEFAULT_PROFILES_FILE": null
                },
                "delay": 1000
            },
            {
                "id": "simulation_outdoor_fastlio",
                "description": "户外机器狗 FAST-LIO 3D 定位",
                "command": "ros2",
                "args": [
                    "run",
                    "fast_lio",
                    "fastlio_mapping",
                    "--ros-args",
                    "--params-file",
                    "config/fastlio_sim.yaml",
                    "-r",
                    "__node:=fastlio_outdoor",
                    "-r",
                    "/points:=/outdoor/points",
                    "-r",
                    "/imu:=/outdoor/imu",
                    "-r",
                    "/Odometry:=/outdoor/Odometry",
                    "-r",
                    "/cloud_registered:=/outdoor/cloud_registered",
                    "-r",
                    "/path:=/outdoor/path",
                    "-r",
                    "/tf:=/outdoor/tf",
                    "-r",
                    "/Laser_map:=/outdoor/Laser_map",
                    "-r",
                    "/cloud_effected:=/outdoor/cloud_effected",
                    "-r",
                    "/cloud_registered_body:=/outdoor/cloud_registered_body"
                ],
                "env": {
                    "ROS_DOMAIN_ID": "88",
                    "FASTRTPS_DEFAULT_PROFILES_FILE": null
                },
                "delay": 22000
            }
        ],
        "mapping": [
            {
                "id": "fastlio_mapping",
                "description": "FAST-LIO 3D 建图节点",
                "command": "ros2",
                "args": [
                    "run",
                    "fast_lio",
                    "fastlio_mapping",
                    "--ros-args",
                    "--params-file",
                    "config/fastlio_sim.yaml"
                ],
                "env": {
                    "ROS_DOMAIN_ID": "88"
                },
                "delay": 0
            }
        ],
        "navigation": []
    },
    "save_map": {
        "command": "ros2",
        "args": [
            "run",
            "nav2_map_server",
            "map_saver_cli",
            "-f"
        ]
    },
    "topics": {
        "camera_primary": "/camera1/preview/compressed",
        "cmd_vel": "/cmd_vel",
        "manual_cmd_vel": "/manual_cmd_vel",
        "battery": "/battery",
        "map": "/map",
        "scan": "/scan",
        "tf": "/tf",
        "odom": "/odom",
        "plan": "/plan",
        "goal_pose": "/goal_pose",
        "initial_pose": "/initialpose",
        "navigate_feedback": "/navigate_to_pose/_action/feedback",
        "navigate_status": "/navigate_to_pose/_action/status",
        "imu": "/imu",
        "pointcloud": "/points",
        "registered_cloud": "/cloud_registered",
        "fastlio_odom": "/Odometry",
        "fastlio_path": "/path",
        "localization": "/localization",
        "localization_path": "/localization/path",
        "global_map": "/global_map"
    }
}
